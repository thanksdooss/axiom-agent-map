@prefix ax: <https://example.org/axiom#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# 클래스
ax:Agent a owl:Class .
ax:Department a owl:Class .
ax:Platform a owl:Class .
ax:DataAsset a owl:Class .
ax:WorkType a owl:Class .

# 관계(허용 관계 코드)
ax:USES_RESULT_OF a owl:ObjectProperty ; rdfs:label "결과사용"@ko ; rdfs:domain ax:Agent ; rdfs:range ax:Agent ; skos:definition "주어 Agent가 대상 Agent의 출력 결과를 입력으로 쓴다"@ko .
ax:ACCESSES_DATA a owl:ObjectProperty ; rdfs:label "데이터사용"@ko ; rdfs:domain ax:Agent ; rdfs:range ax:DataAsset ; skos:definition "주어 Agent가 대상 데이터를 읽거나 쓴다"@ko .
ax:USES_PLATFORM a owl:ObjectProperty ; rdfs:label "사용 플랫폼"@ko ; rdfs:domain ax:Agent ; rdfs:range ax:Platform ; skos:definition "주어 Agent가 대상 플랫폼에 연동되어 동작한다"@ko .
ax:BELONGS_TO a owl:ObjectProperty ; rdfs:label "소속"@ko ; rdfs:domain ax:Agent ; rdfs:range ax:Department ; skos:definition "주어 Agent를 운영·책임지는 부서"@ko .
ax:HAS_WORK_TYPE a owl:ObjectProperty ; rdfs:label "업무 성격"@ko ; rdfs:domain ax:Agent ; rdfs:range ax:WorkType ; skos:definition "주어 Agent의 주된 업무 유형"@ko .
ax:STORED_IN a owl:ObjectProperty ; rdfs:label "저장 위치"@ko ; rdfs:domain ax:DataAsset ; rdfs:range ax:Platform ; skos:definition "주어 데이터가 저장·관리되는 플랫폼"@ko .
ax:sensitivity a owl:DatatypeProperty ; rdfs:label "민감도"@ko ; rdfs:domain ax:DataAsset .

ax:departments a skos:ConceptScheme .

ax:DEP01 a skos:Concept, ax:Department ; skos:inScheme ax:departments ; skos:prefLabel "영업팀"@ko ;
    skos:altLabel "영업본부/기업영업팀"@ko ;
    skos:altLabel "기업영업팀"@ko ;
    skos:definition "고객 영업과 견적·계약 갱신을 맡는 팀"@ko ;
    skos:note "상위 분류: 영업본부"@ko .
ax:DEP02 a skos:Concept, ax:Department ; skos:inScheme ax:departments ; skos:prefLabel "마케팅팀"@ko ;
    skos:altLabel "마케팅"@ko ;
    skos:definition "캠페인 기획과 고객 세그먼트 분석을 맡는 팀"@ko ;
    skos:note "상위 분류: 마케팅본부"@ko .
ax:DEP03 a skos:Concept, ax:Department ; skos:inScheme ax:departments ; skos:prefLabel "고객지원팀"@ko ;
    skos:altLabel "CS팀"@ko ;
    skos:altLabel "고객센터"@ko ;
    skos:definition "고객 문의 응대와 VOC 관리를 맡는 팀"@ko ;
    skos:note "상위 분류: 고객본부"@ko .
ax:DEP04 a skos:Concept, ax:Department ; skos:inScheme ax:departments ; skos:prefLabel "개발팀"@ko ;
    skos:altLabel "개발본부 플랫폼개발팀"@ko ;
    skos:altLabel "플랫폼개발팀"@ko ;
    skos:definition "사내 서비스 개발과 코드 품질을 맡는 팀"@ko ;
    skos:note "상위 분류: 개발본부"@ko .
ax:DEP05 a skos:Concept, ax:Department ; skos:inScheme ax:departments ; skos:prefLabel "IT운영팀"@ko ;
    skos:altLabel "IT운영"@ko ;
    skos:definition "계정·장비·클라우드·보안 운영을 맡는 팀"@ko ;
    skos:note "상위 분류: 개발본부"@ko .
ax:DEP06 a skos:Concept, ax:Department ; skos:inScheme ax:departments ; skos:prefLabel "인사팀"@ko ;
    skos:altLabel "HR팀"@ko ;
    skos:altLabel "인사 팀"@ko ;
    skos:definition "채용·교육·인사 정보를 맡는 팀"@ko ;
    skos:note "상위 분류: 경영지원본부"@ko .
ax:DEP07 a skos:Concept, ax:Department ; skos:inScheme ax:departments ; skos:prefLabel "재무팀"@ko ;
    skos:altLabel "재무"@ko ;
    skos:definition "결산·경비·급여·세무를 맡는 팀"@ko ;
    skos:note "상위 분류: 경영지원본부"@ko .
ax:DEP08 a skos:Concept, ax:Department ; skos:inScheme ax:departments ; skos:prefLabel "구매팀"@ko ;
    skos:altLabel "구매"@ko ;
    skos:definition "발주·공급업체·재고 보충을 맡는 팀"@ko ;
    skos:note "상위 분류: 경영지원본부"@ko .
ax:DEP09 a skos:Concept, ax:Department ; skos:inScheme ax:departments ; skos:prefLabel "법무팀"@ko ;
    skos:altLabel "법무"@ko ;
    skos:definition "계약 검토·법령 대응·개인정보 점검을 맡는 팀"@ko ;
    skos:note "상위 분류: 경영지원본부"@ko .
ax:DEP10 a skos:Concept, ax:Department ; skos:inScheme ax:departments ; skos:prefLabel "경영기획팀"@ko ;
    skos:altLabel "경영기획"@ko ;
    skos:definition "경영 현황 보고와 예산 편성을 맡는 팀"@ko ;
    skos:note "상위 분류: 전략본부"@ko .

ax:work_types a skos:ConceptScheme .

ax:WT1 a skos:Concept, ax:WorkType ; skos:inScheme ax:work_types ; skos:prefLabel "문서 작성"@ko ;
    skos:altLabel "문서 생성"@ko ;
    skos:altLabel "보고서 작성"@ko ;
    skos:definition "정해진 양식의 업무 문서(견적서·보고서·계약서 초안 등)를 만든다"@ko .
ax:WT2 a skos:Concept, ax:WorkType ; skos:inScheme ax:work_types ; skos:prefLabel "콘텐츠 생성"@ko ;
    skos:altLabel "콘텐츠 제작"@ko ;
    skos:altLabel "문구 생성"@ko ;
    skos:definition "독자에게 보낼 글(캠페인 문구·공지·보도자료)을 만든다"@ko .
ax:WT3 a skos:Concept, ax:WorkType ; skos:inScheme ax:work_types ; skos:prefLabel "데이터 분석"@ko ;
    skos:altLabel "분석"@ko ;
    skos:definition "데이터를 집계·분석해 점수·분류·예측·인사이트를 낸다"@ko .
ax:WT4 a skos:Concept, ax:WorkType ; skos:inScheme ax:work_types ; skos:prefLabel "검토·심사"@ko ;
    skos:altLabel "검토"@ko ;
    skos:altLabel "심사"@ko ;
    skos:definition "문서나 요청이 기준에 맞는지 검토하고 판단을 제안한다"@ko .
ax:WT5 a skos:Concept, ax:WorkType ; skos:inScheme ax:work_types ; skos:prefLabel "고객 응대"@ko ;
    skos:altLabel "상담"@ko ;
    skos:definition "고객과 직접 대화하며 문의에 답한다"@ko .
ax:WT6 a skos:Concept, ax:WorkType ; skos:inScheme ax:work_types ; skos:prefLabel "모니터링"@ko ;
    skos:altLabel "알림"@ko ;
    skos:altLabel "감시"@ko ;
    skos:definition "상태를 계속 지켜보다가 이상이나 기한을 알린다"@ko .
ax:WT7 a skos:Concept, ax:WorkType ; skos:inScheme ax:work_types ; skos:prefLabel "검색·요약"@ko ;
    skos:altLabel "요약"@ko ;
    skos:altLabel "Q&A"@ko ;
    skos:definition "문서나 기록을 찾아 요약하거나 질문에 답한다"@ko .
ax:WT8 a skos:Concept, ax:WorkType ; skos:inScheme ax:work_types ; skos:prefLabel "자동화 처리"@ko ;
    skos:altLabel "업무 자동화"@ko ;
    skos:altLabel "자동화"@ko ;
    skos:definition "반복 업무를 규칙에 따라 자동으로 처리한다"@ko .

